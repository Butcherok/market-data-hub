# Скопируй в .env и заполни при необходимости. Файл .env не коммитится (см. .gitignore).

# Необязательный токен авторизации. Если задан — все /api/* запросы должны
# нести заголовок "Authorization: Bearer <токен>". Если бэкенд доступен только
# внутри Tailscale-сети (см. README), можно оставить пустым — сетевая изоляция
# уже ограничивает доступ.
MARKET_DATA_AUTH_TOKEN=

# Путь к файлу SQLite. По умолчанию backend/data/market_data.db
MARKET_DATA_DB_PATH=
