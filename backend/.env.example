# Скопируй в .env и заполни при необходимости. Файл .env не коммитится (см. .gitignore).

# Путь к файлу SQLite. По умолчанию backend/data/market_data.db
MARKET_DATA_DB_PATH=

# Домен, с которого разрешено обращаться к API (CORS). Не задан — разрешено
# всё, это нормально для localhost/Tailscale (сеть уже закрыта). При
# публикации через Cloudflare Tunnel/ngrok — ОБЯЗАТЕЛЬНО указать точный
# публичный адрес фронтенда.
# Пример: MARKET_DATA_ALLOWED_ORIGIN=https://data.example.com
MARKET_DATA_ALLOWED_ORIGIN=

# Авторизация больше не через общий секрет в .env — персональные токены на
# человека выдаются через backend/manage_users.py (add/list/revoke). Пока в
# базе нет ни одного пользователя, API открыт (доступ ограничен только
# сетью). См. README, раздел "Публикация наружу".
